---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" description="Essa página não existe." path="/404/" noindex>
  <section class="page-hero">
    <h1 class="display">Página não encontrada.</h1>
    <p class="lead" style="margin-top:24px">O endereço que você abriu não existe mais ou foi digitado errado.</p>
    <p style="margin-top:32px"><a class="btn" href="/">Voltar ao início</a></p>
  </section>
</Base>
